# Environment for this project. Run `direnv allow` once after cloning.
# Requires direnv + uv. We never use manual `python -m venv` / activation —
# direnv owns the environment and loads variables from .env.

dotenv_if_exists                      # load .env into the environment

export UV_PROJECT_ENVIRONMENT=".venv"
uv sync --quiet                       # keep the venv in sync with pyproject/uv.lock
source .venv/bin/activate
