# Application
export APP_NAME=edith
export ENVIRONMENT=development  # development | production (label only)
export LOG_LEVEL=INFO
export LOG_FORMAT=json          # json (default, machine-parseable) | console (local only)

# Auth — clients send Authorization: Bearer $API_TOKEN
export API_TOKEN=dev-token

# Edith's own state: the recent-projects list (default ~/.edith). Projects are self-contained
# folders anywhere on disk and keep everything else in the folder.
# export STATE_DIR=~/.edith

# One-off: a folder from before projects were self-contained (one sub-folder per project). Its
# projects are converted and added to the recent list at startup. (Formerly LIBRARY_DIR.)
# export LEGACY_LIBRARY_DIR=../.library
