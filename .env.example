# Used by `just` and Docker Compose (the backend and frontend have their own .env.example).

# Bearer token shared by the API and the web build.
API_TOKEN=dev-token

# The folder Edith can see under Docker: projects can be anywhere inside it. It is mounted at the
# same path inside the container as on your machine. Default: your home folder; use /Volumes to
# work with external drives.
# EDITH_MOUNT=/Volumes

# One-off: a folder from before projects were self-contained (one sub-folder per project). Its
# projects are converted and added to the recent list at startup. Must be inside EDITH_MOUNT.
# LEGACY_LIBRARY_DIR=
